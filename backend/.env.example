# Copy this file to .env and fill in real values. Never commit .env.

# Any long random string - signs OAuth state tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_SECRET=

# A second, separate long random string - signs user session tokens. Generate the same way.
JWT_SECRET=

# Postgres connection string. For a free hosted database, create a project at
# https://neon.tech and copy its connection string here (looks like
# postgres://user:password@host/dbname?sslmode=require).
DATABASE_URL=

# Set to "false" only if you're pointing at a local Postgres install without SSL configured.
# Leave unset/true for Neon or any other managed Postgres, which require SSL.
PGSSL=

# Where your static frontend is served from (index.html/login.html/plan.html etc).
# Used for CORS and for where to redirect the browser after OAuth completes.
FRONTEND_ORIGIN=http://localhost:5500

PORT=4000

# How often (in minutes) the server automatically pulls fresh data for every connected
# device, in the background, with no action needed from the user.
SYNC_INTERVAL_MINUTES=15

# --- Google Health API (covers both Fitbit devices and Pixel/Wear OS) ---
# Fitbit and the old Google Fit API have merged into one unified API. Create a project at
# https://console.cloud.google.com, enable the "Google Health API", configure the OAuth
# consent screen, then create an OAuth Client ID (type: Web application).
# Add GOOGLE_HEALTH_REDIRECT_URI below to "Authorized redirect URIs".
# While your app is in Testing mode, add the Google accounts you want to test with under
# "Test users" on the consent screen - no approval wait needed for personal/testing use.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:4000/auth/devices/googleHealth/callback
