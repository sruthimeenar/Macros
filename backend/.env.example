# Copy this file to .env and fill in real values. Never commit .env.

# Any long random string - signs OAuth state tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_SECRET=

# A second, separate long random string - signs user session tokens. Generate the same way.
JWT_SECRET=

# Postgres connection string. For a free hosted database, create a project at
# https://neon.tech and copy its connection string here (looks like
# postgres://user:password@host/dbname?sslmode=require).
DATABASE_URL=

# Set to "false" only if you're pointing at a local Postgres install without SSL configured.
# Leave unset/true for Neon or any other managed Postgres, which require SSL.
PGSSL=

# Where your static frontend is served from (index.html/login.html/plan.html etc).
# Used for CORS and for where to redirect the browser after OAuth completes.
FRONTEND_ORIGIN=http://localhost:5500

PORT=4000

# How often (in minutes) the server automatically pulls fresh data for every connected
# device, in the background, with no action needed from the user.
SYNC_INTERVAL_MINUTES=15

# --- Fitbit ---
# Register an app at https://dev.fitbit.com/apps/new
# OAuth 2.0 Application Type: Server
# Redirect URL must exactly match FITBIT_REDIRECT_URI below.
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:4000/auth/devices/fitbit/callback

# Optional: only needed if you also set up Fitbit's push-notification "Subscriber" endpoint
# for near-real-time updates (in addition to the automatic background polling above).
# Set this to whatever verify code Fitbit's dashboard shows you when adding a subscriber.
# Point Fitbit's endpoint at: https://your-backend-domain/webhooks/fitbit
FITBIT_VERIFY_CODE=

# --- Google Fit ---
# Create a project at https://console.cloud.google.com, enable the "Fitness API",
# configure the OAuth consent screen, then create an OAuth Client ID (type: Web application).
# Add GOOGLE_FIT_REDIRECT_URI below to "Authorized redirect URIs".
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=
GOOGLE_FIT_REDIRECT_URI=http://localhost:4000/auth/devices/googleFit/callback
